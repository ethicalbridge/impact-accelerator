{
  "name": "handova",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "e2e": "playwright test -c tests/e2e",
    "i18n:check": "node scripts/i18n-check.mjs",
    "qa": "MOCK=1 OUT=../qa-site node scripts/build.mjs && node scripts/serve.mjs ../qa-site",
    "start": "node scripts/serve.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "playwright": "1.56.1",
    "prettier": "3.6.2"
  }
}
